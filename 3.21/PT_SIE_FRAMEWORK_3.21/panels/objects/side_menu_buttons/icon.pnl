  <script isEscaped="1" name="ScopeLib"><![CDATA[public void SetSelBackCol(string color){
  selSide.backCol(color);
}

public void SetUserText(string initials){
  setValue(&quot;ptText&quot;, &quot;text&quot;, initials/*, &quot;visible&quot;, initials!=&quot;&quot;*/);
  //selSide.visible(false);
}

public void SetIcon(string sIconFileName)
{
  if (sIconFileName != &quot;&quot;)
  {
    setMultiValue(//&quot;ptText&quot;, &quot;visible&quot;, false,
                  &quot;rIcon&quot;, &quot;fill&quot;, &quot;[pattern,[fit,any,&quot; + sIconFileName + &quot;]]&quot;);
  }
}
]]></script>
